{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "bun"],
    "lib": ["ES2023", "esnext.disposable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": ["**/*.ts"],
  "exclude": [
    "probe-orchestration-snapshot.ts",
    "probe-compact-queue-scenario.ts",
    "opencode-launch-smoke.ts",
    "opencode-config-ux-drive.ts",
    "opencode-providers-ux-smoke.ts",
    "settings-ux-drive.ts"
  ]
}
